# Course-Builder Supabase project = platform Auth + course data.
# Same values are used as Platform Auth across the hub and other tools.
VITE_SUPABASE_URL=your-course-builder-project-url
VITE_SUPABASE_ANON_KEY=your-course-builder-anon-key

# Prefer these names on hub / other tools (alias to the same Course-Builder project):
# VITE_PLATFORM_SUPABASE_URL=...
# VITE_PLATFORM_SUPABASE_ANON_KEY=...

# Server-only (never VITE_) — needed for hub handoff APIs when developed from this project
# PLATFORM_SUPABASE_SERVICE_ROLE_KEY=your-course-builder-service-role-key
