# Platform Auth (Course-Builder Supabase project) — required for login / API access.
VITE_PLATFORM_SUPABASE_URL=your-course-builder-project-url
VITE_PLATFORM_SUPABASE_ANON_KEY=your-course-builder-anon-key

# Virtual-Support data project (browser only needs URL for config detection;
# all data writes go through /api/data with service_role on the server).
VITE_SUPABASE_URL=your-virtual-support-project-url
VITE_SUPABASE_ANON_KEY=your-virtual-support-anon-key

# Server-only
PLATFORM_SUPABASE_URL=your-course-builder-project-url
PLATFORM_SUPABASE_ANON_KEY=your-course-builder-anon-key
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=your-course-builder-service-role-key
VS_SUPABASE_URL=your-virtual-support-project-url
VS_SUPABASE_SERVICE_ROLE_KEY=your-virtual-support-service-role-key

OPENAI_API_KEY=sk-...

# Optional: override hub origin for back-link
# VITE_HUB_URL=https://ai-tools-tauonline.vercel.app
