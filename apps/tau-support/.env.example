# Platform Auth (Course-Builder Supabase project) — required for login / API access.
VITE_PLATFORM_SUPABASE_URL=your-course-builder-project-url
VITE_PLATFORM_SUPABASE_ANON_KEY=your-course-builder-anon-key

# Tau-Support data project (browser only needs URL for config detection;
# all data writes go through /api/tau-data with service_role on the server).
VITE_SUPABASE_URL=your-tau-support-project-url
VITE_SUPABASE_ANON_KEY=your-tau-support-anon-key

# Server-only
PLATFORM_SUPABASE_URL=your-course-builder-project-url
PLATFORM_SUPABASE_ANON_KEY=your-course-builder-anon-key
PLATFORM_SUPABASE_SERVICE_ROLE_KEY=your-course-builder-service-role-key
TAU_SUPABASE_URL=your-tau-support-project-url
TAU_SUPABASE_SERVICE_ROLE_KEY=your-tau-support-service-role-key

OPENAI_API_KEY=sk-...

# LMS (Campus IL) — server only
# LMS_BASE_URL=
# LMS_USERNAME=
# LMS_PASSWORD=
