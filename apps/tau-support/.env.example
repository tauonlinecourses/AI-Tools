# TAU Support — environment variables (client-side; anon key is public by design).
# Copy to .env and fill in from your DEDICATED tau-support Supabase project
# (Project Settings -> API). Must be prefixed VITE_ so Vite exposes them to the
# browser bundle. If these are absent, the app still works — Supabase sync is
# simply skipped (localStorage inbox remains the source of truth in the browser).

VITE_SUPABASE_URL=your-tau-support-project-url
VITE_SUPABASE_ANON_KEY=your-tau-support-anon-key

# Never put the service_role / secret key here — it must not ship to the browser.
