# TAU Support — environment variables.
# Copy to .env and fill in values. Restart Vite / redeploy after changes.

# UI gate password (server-only — do NOT prefix with VITE_).
# When set, the app shows a login screen until this password is entered.
# Also set the same value in Vercel project env for production.
APP_PASSWORD=choose-a-strong-password

# Client-side Supabase (anon key is public by design). Must be prefixed VITE_
# so Vite exposes them to the browser bundle. If absent, Supabase sync is
# skipped (localStorage inbox remains the source of truth in the browser).
VITE_SUPABASE_URL=your-tau-support-project-url
VITE_SUPABASE_ANON_KEY=your-tau-support-anon-key

# Never put the service_role / secret key here — it must not ship to the browser.

# Server-only OpenAI key for /api/embed (Q↔A vectors + similar-question search).
# Do NOT prefix with VITE_. Also set on Vercel for production.
OPENAI_API_KEY=sk-...

